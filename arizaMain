  Widget build(BuildContext context) {
    return Scaffold(
      
  appBar: AppBar(
  title: Text('Parça Düzenle'),
  actions: [
    IconButton(
      icon: Icon(Icons.delete),
      tooltip: 'Parçayı Sil',
      onPressed: () {
        showDialog(
          context: context,
          builder: (context) => AlertDialog(
            title: Text('Parçayı Sil'),
            content: Text('Bu parçayı silmek istediğinizden emin misiniz?'),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(context),
                child: Text('İptal'),
              ),
              TextButton(
                onPressed: () {
                  parcalar.remove(widget.parcaId);
                  Navigator.pop(context);
                  Navigator.pop(context);
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(content: Text('Parça silindi!')),
                  );
                },
                child: Text('Sil', style: TextStyle(color: Colors.red)),
              ),
            ],
          ),
        );
      },
    ),
  ],
),
	  
      body: Padding(
        padding: EdgeInsets.all(16),
        child: Column(
          children: [
            TextField(
              controller: adController,
              decoration: InputDecoration(
                labelText: 'Parça Adı',
                border: OutlineInputBorder(),
              ),
            ),
            SizedBox(height: 20),
            TextField(
              controller: fiyatController,
              keyboardType: TextInputType.number,
