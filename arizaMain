class ParcaEkleEkrani extends StatefulWidget {
  @override
  _ParcaEkleEkraniState createState() => _ParcaEkleEkraniState();
}

class _ParcaEkleEkraniState extends State<ParcaEkleEkrani> {
  TextEditingController adController = TextEditingController();
  TextEditingController fiyatController = TextEditingController();

  @override
  void dispose() {
    adController.dispose();
    fiyatController.dispose();
    super.dispose();
  }

  void ekle() {
    if (adController.text.isEmpty || fiyatController.text.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Lütfen tüm alanları doldurun!')),
      );
      return;
    }
    // Yeni parça ID'si oluştur (P008, P009...)
     int enBuyukId = 0;
    parcalar.keys.forEach((key) {
      int id = int.tryParse(key.replaceAll('P', '')) ?? 0;
      if (id > enBuyukId) enBuyukId = id;
    });
    String yeniParcaId = 'P${(enBuyukId + 1).toString().padLeft(3, '0')}';
	

    setState(() {
      parcalar[yeniParcaId] = {
        'ad': adController.text,
        'fiyat': int.tryParse(fiyatController.text) ?? 0,
      };
    });

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('Yeni parça eklendi: $yeniParcaId')),
    );

    Navigator.pop(context);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text('Yeni Parça Ekle'),
      ),
      body: Padding(
        padding: EdgeInsets.all(16),
        child: Column(
          children: [
            TextField(
              controller: adController,
              decoration: InputDecoration(
                labelText: 'Parça Adı',
                border: OutlineInputBorder(),
              ),
            ),
            SizedBox(height: 20),
            TextField(
              controller: fiyatController,
              keyboardType: TextInputType.number,
              decoration: InputDecoration(
                labelText: 'Fiyat (TL)',
                border: OutlineInputBorder(),
              ),
            ),
            SizedBox(height: 20),
            ElevatedButton(
              onPressed: ekle,
              child: Text('Kaydet'),
              style: ElevatedButton.styleFrom(
                padding: EdgeInsets.all(16),
                textStyle: TextStyle(fontSize: 18),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
