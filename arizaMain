  _ParcaDuzenleEkraniState createState() => _ParcaDuzenleEkraniState();
}

class _ParcaDuzenleEkraniState extends State<ParcaDuzenleEkrani> {
  late TextEditingController adController;
  late TextEditingController fiyatController;

  @override
  void initState() {
    super.initState();
    adController = TextEditingController(text: parcalar[widget.parcaId]!['ad']);
    fiyatController = TextEditingController(
      text: parcalar[widget.parcaId]!['fiyat'].toString(),
    );
  }

  @override
  void dispose() {
    adController.dispose();
    fiyatController.dispose();
    super.dispose();
  }

  void kaydet() {
    setState(() {
      parcalar[widget.parcaId]!['ad'] = adController.text;
      parcalar[widget.parcaId]!['fiyat'] = int.tryParse(fiyatController.text) ?? 0;
    });

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('Parça güncellendi!')),
    );

    Navigator.pop(context);
  }

