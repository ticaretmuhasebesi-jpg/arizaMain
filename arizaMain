// ARIZA VERİLERİ SONU *******************

Future<void> parcalariKaydet() async {
  final prefs = await SharedPreferences.getInstance();
  String jsonString = jsonEncode(parcalar);
  await prefs.setString('parcalar', jsonString);
}

Future<void> parcalariYukle() async {
  final prefs = await SharedPreferences.getInstance();
  String? jsonString = prefs.getString('parcalar');
  if (jsonString != null) {
    Map<String, dynamic> decoded = jsonDecode(jsonString);
    parcalar.clear();
    decoded.forEach((key, value) {
      parcalar[key] = Map<String, dynamic>.from(value);
    });
  }
}

void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  await parcalariYukle();
  runApp(MyApp());
}



